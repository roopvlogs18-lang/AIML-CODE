      "source": [
        " from collections import deque\n",
        "\n",
        "def solve_water_jug_bfs(cap_a, cap_b, target):\n",
        "    # Queue stores tuples of (state, path_taken)\n",
        "    # State format: (jug_a_water, jug_b_water)\n",
        "    start_state = (0, 0)\n",
        "    queue = deque([(start_state, [(start_state, \"Initial state\")])])\n",
        "    visited = {start_state}\n",
        "\n",
        "    while queue:\n",
        "        (a, b), path = queue.popleft()\n",
        "\n",
        "        # Goal check: either jug contains the target amount\n",
        "        if a == target or b == target:\n",
        "            return path\n",
        "\n",
        "        # Generate all 6 possible next moves\n",
        "        moves = [\n",
        "            ((cap_a, b), f\"Fill Jug A completely -> ({cap_a}, {b})\"),\n",
        "            ((a, cap_b), f\"Fill Jug B completely -> ({a}, {cap_b})\"),\n",
        "            ((0, b), f\"Empty Jug A -> (0, {b})\"),\n",
        "            ((a, 0), f\"Empty Jug B -> ({a}, 0)\"),\n",
        "        ]\n",
        "\n",
        "        # Pour A -> B\n",
        "        pour_a_to_b = min(a, cap_b - b)\n",
        "        moves.append(((a - pour_a_to_b, b + pour_a_to_b),\n",
        "                       f\"Pour Jug A into Jug B -> ({a - pour_a_to_b}, {b + pour_a_to_b})\"))\n",
        "\n",
        "        # Pour B -> A\n",
        "        pour_b_to_a = min(b, cap_a - a)\n",
        "        moves.append(((a + pour_b_to_a, b - pour_b_to_a),\n",
        "                       f\"Pour Jug B into Jug A -> ({a + pour_b_to_a}, {b - pour_b_to_a})\"))\n",
        "\n",
        "        # Explore unvisited states\n",
        "        for next_state, action in moves:\n",
        "            if next_state not in visited:\n",
        "                visited.add(next_state)\n",
        "                queue.append((next_state, path + [(next_state, action)]))\n",
        "\n",
        "    return None\n",
        "\n",
        "# Problem Execution\n",
        "capacity_A = 4\n",
        "capacity_B = 3\n",
        "target_amount = 2\n",
        "\n",
        "shortest_path = solve_water_jug_bfs(capacity_A, capacity_B, target_amount)\n",
        "\n",
        "if shortest_path:\n",
        "    print(f\"Minimum steps required: {len(shortest_path) - 1}\\n\")\n",
        "    for step_num, (state, action) in enumerate(shortest_path):\n",
        "        print(f\"Step {step_num}: {action}\")\n",
        "else:\n",
        "    print(\"No solution exists for these capacities and target.\")"
      ]
